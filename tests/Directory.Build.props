<Project>
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>

    <!-- An un-awaited assertion never runs; TUnit's analyzer flags it, and this makes it fail the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Verify maintenance fee: open source, non-revenue exemption. Time-bounded (max 12 months), so renew it before it
         lapses. -->
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-09</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>
</Project>
