<Project>
  <!-- What the packages in src share: MongoFlow and MongoFlow.Identity ship together, with one version. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>InsurUp</Authors>
    <PackageProjectUrl>https://github.com/InsurUp/MongoFlow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/InsurUp/MongoFlow</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <!-- Local packs; a release takes its version from the tag. -->
    <Version>1.0.0-beta.7</Version>
    <PackageReleaseNotes>https://github.com/InsurUp/MongoFlow/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <!-- The API docs for IntelliSense, and a symbols package Source Link points at the commit with. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A parameter is documented where it needs saying, so some of a member's can go without. -->
    <NoWarn>$(NoWarn);CS1573</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
