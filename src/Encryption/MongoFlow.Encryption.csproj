<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>MongoFlow.Encryption</Title>
    <PackageId>MongoFlow.Encryption</PackageId>
    <Product>MongoFlow.Encryption</Product>
    <Description>MongoDB Queryable Encryption for MongoFlow vaults: encrypted members declared on collections, encrypted and queried by MongoFlow, on MongoDB Community too.</Description>
    <Summary>MongoDB Queryable Encryption for MongoFlow vaults.</Summary>
    <PackageTags>mongoflow;mongodb;mongo;encryption;queryable-encryption;csfle;nosql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver.Encryption" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\MongoFlow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MongoFlow.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
