{
  // Without a connection string, the samples start MongoDB in Docker. A server of your own must be MongoDB 8.0 or later,
  // as a replica set; each run then writes to databases of its own, or to those Database:Prefix names.
  //   "ConnectionStrings": { "Mongo": "mongodb://localhost:27017/?replicaSet=rs0" },
  //   "Database": { "Prefix": "samples_" },

  // MongoFlow logs under MongoFlow.* categories; MongoFlowLogEvents lists them and every event ID. Information shows
  // migrations and the warnings about missing indexes. Debug on MongoFlow.Save shows each save, the transaction it runs
  // in and what it changed; Trace on MongoFlow.Query shows the filters each read runs with. From the command line:
  //   dotnet run --project samples/MongoFlow.Samples -- --Logging:LogLevel:MongoFlow.Save=Debug
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "MongoFlow": "Information",
      "MongoFlow.Samples": "Information"
    }
  }
}
